# Rules for Auditbeat that are mapped to MITRE's Attack Framework
# Originally based on the work by Wouter Stinkens, see:
# https://github.com/NVISOsecurity/ansible-auditbeat
#
# Linux Audit Rules
# Combines compliance monitoring with MITRE ATT&CK framework coverage
# Optimized for comprehensive security monitoring

#######################################################################
# Buffer and System Configuration
#######################################################################

## Increase backlog buffer size to avoid audit events getting dropped under load
## One very busy systems, you may need to increase this. On severely memory-constrained systems, decrease it
-b 8192

## Backlog wait time is often 1 minute by default, but we set it just to be certain
--backlog_wait_time 60000

## When auditing fails, log to kernel log but do not kernel panic the system
-f 1

## Enable audit, but do not require a reboot to update the rules
-e 1

#######################################################################
# Filter Rules (Must be first - first match wins)
#######################################################################

## Ignore End Of Event messages
-a always,exclude -F msgtype=EOE

## Filter out cron jobs to reduce noise
-a never,user -F subj_type=crond_t
-a exit,never -F subj_type=crond_t

{|#LINUX_SYSTEM_HYPERVISOR_VMWARE|}
## Filter out VMWare tools (if running on VMware)
-a exit,never -F arch=b32 -S fork -F success=0 -F path=/usr/lib/vmware-tools -F subj_type=initrc_t -F exit=-2
-a exit,never -F arch=b64 -S fork -F success=0 -F path=/usr/lib/vmware-tools -F subj_type=initrc_t -F exit=-2
{|/LINUX_SYSTEM_HYPERVISOR_VMWARE|}

#######################################################################
# Identity and Authentication Monitoring
#######################################################################

## Account/User file changes
-w /etc/group -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1087_Account_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/passwd -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1087_Account_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/gshadow -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1087_Account_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/shadow -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1087_Account_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/security/opasswd -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1087_Account_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Sudo configuration changes
-w /etc/sudoers -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/sudoers.d/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /var/log/sudo.log -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1070_Indicator_Removal_on_Host{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Login monitoring
-w /var/log/lastlog -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1021_Remote_Services{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /var/run/faillock -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1021_Remote_Services{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /var/log/faillog -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1021_Remote_Services{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /var/log/tallylog -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1021_Remote_Services{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Session monitoring
-w /var/run/utmp -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1108_Redundant_Access{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /var/log/wtmp -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1108_Redundant_Access{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /var/log/btmp -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1108_Redundant_Access{|/LINUX_SYSTEM_AUDIT_MITRE|}

## User emulation detection (effective UID != audit UID)
-a always,exit -F arch=b64 -C euid!=uid -F auid!=unset -S execve{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1169_Sudo{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -C euid!=uid -F auid!=unset -S execve{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1169_Sudo{|/LINUX_SYSTEM_AUDIT_MITRE|}

#######################################################################
# Privileged Command Monitoring
#######################################################################

## Core privileged commands
-a always,exit -F path=/usr/bin/sudo -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/su -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/passwd -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/gpasswd -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/newgrp -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}

## User management commands
-a always,exit -F path=/usr/sbin/useradd -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/sbin/usermod -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/sbin/userdel -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/sbin/groupadd -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/sbin/groupmod -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/sbin/groupdel -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/sbin/adduser -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}

## System administration tools
-a always,exit -F path=/usr/bin/chage -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/chfn -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/chsh -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/mount -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/umount -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Permission/ACL tools
-a always,exit -F path=/usr/bin/setfacl -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/chacl -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/chcon -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Scheduling tools
-a always,exit -F path=/usr/bin/crontab -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/at -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Network tools
-a always,exit -F path=/usr/bin/ssh-agent -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Additional SUID/SGID binaries (Debian-specific)
-a always,exit -F path=/usr/bin/dotlockfile -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/expiry -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/fusermount3 -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/plocate -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1083_File_and_Directory_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/wall -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/bin/write -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/lib/dbus-1.0/dbus-daemon-launch-helper -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/lib/openssh/ssh-keysign -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/sbin/exim4 -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F path=/usr/sbin/unix_chkpwd -F perm=x -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Root command execution monitoring
-a exit,always -F arch=b64 -F euid=0 -S execve{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a exit,always -F arch=b32 -F euid=0 -S execve{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1078_Valid_Accounts{|/LINUX_SYSTEM_AUDIT_MITRE|}

#######################################################################
# System Configuration Monitoring
#######################################################################

## Time changes
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1099_Timestomp{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1099_Timestomp{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/localtime -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1099_Timestomp{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Hostname and locale changes
-a always,exit -F arch=b64 -S sethostname,setdomainname{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1082_System_Information_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S sethostname,setdomainname{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1082_System_Information_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/issue -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1082_System_Information_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/issue.net -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1082_System_Information_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/hosts -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1016_System_Network_Configuration_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/networks -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1016_System_Network_Configuration_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/network/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1016_System_Network_Configuration_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/hostname -p r{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1082_System_Information_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/resolv.conf -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1016_System_Network_Configuration_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/hosts.allow -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1016_System_Network_Configuration_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/hosts.deny -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1016_System_Network_Configuration_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Security policy changes
-w /etc/apparmor/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1562_Impair_Defenses{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/apparmor.d/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1562_Impair_Defenses{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/login.defs -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1082_System_Information_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/securetty -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1082_System_Information_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Kernel modules
-w /etc/sysctl.conf -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1215_Kernel_Modules_and_Extensions{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/modprobe.conf -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1215_Kernel_Modules_and_Extensions{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module,create_module,query_module -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1215_Kernel_Modules_and_Extensions{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module,create_module,query_module -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1215_Kernel_Modules_and_Extensions{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F perm=x -F auid!=-1 -F path=/sbin/insmod{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1215_Kernel_Modules_and_Extensions{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F perm=x -F auid!=-1 -F path=/sbin/modprobe{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1215_Kernel_Modules_and_Extensions{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F perm=x -F auid!=-1 -F path=/sbin/rmmod{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1215_Kernel_Modules_and_Extensions{|/LINUX_SYSTEM_AUDIT_MITRE|}

#######################################################################
# Job Scheduling Monitoring
#######################################################################

## Cron changes
-w /etc/cron.allow -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/cron.deny -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/cron.d/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/cron.daily/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/cron.hourly/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/cron.monthly/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/cron.weekly/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/crontab -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /var/spool/cron/crontabs/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/anacrontab -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}

## At jobs
-w /etc/at.allow -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/at.deny -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /var/spool/at/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Init system
-w /etc/inittab -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/init.d/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}
-w /etc/init/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1168_Local_Job_Scheduling{|/LINUX_SYSTEM_AUDIT_MITRE|}

#######################################################################
# File System Monitoring
#######################################################################

## Mount operations
-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1052_Exfiltration_Over_Physical_Medium{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S mount -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1052_Exfiltration_Over_Physical_Medium{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Failed file access attempts
-a always,exit -F arch=b64 -S creat,open,openat,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1083_File_and_Directory_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b64 -S creat,open,openat,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1083_File_and_Directory_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S creat,open,openat,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1083_File_and_Directory_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S creat,open,openat,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1083_File_and_Directory_Discovery{|/LINUX_SYSTEM_AUDIT_MITRE|}

## File deletion
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat,rmdir -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1107_File_Deletion{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat,rmdir -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1107_File_Deletion{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat,rmdir -F auid=0{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1070_Indicator_Removal_on_Host{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat,rmdir -F auid=0{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1070_Indicator_Removal_on_Host{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Permission changes
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1166_Seuid_and_Setgid{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b64 -S chown,fchown,lchown,fchownat -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1166_Seuid_and_Setgid{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1166_Seuid_and_Setgid{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S lchown,fchown,chown,fchownat -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1166_Seuid_and_Setgid{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Extended attributes
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1166_Seuid_and_Setgid{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1166_Seuid_and_Setgid{|/LINUX_SYSTEM_AUDIT_MITRE|}

## SUID/SGID changes
-a always,exit -F arch=b64 -S setuid,setgid,setreuid,setregid{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1166_Seuid_and_Setgid{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S setuid,setgid,setreuid,setregid{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1166_Seuid_and_Setgid{|/LINUX_SYSTEM_AUDIT_MITRE|}

#######################################################################
# Network Monitoring
#######################################################################

## SSH configuration
-w /etc/ssh/sshd_config -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1021_Remote_Services{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Network connections (filtered to reduce noise)
-a exit,always -F arch=b64 -S connect -F a2!=110{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1043_Commonly_Used_Port{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a exit,always -F arch=b32 -S socketcall -F a0=3{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1043_Commonly_Used_Port{|/LINUX_SYSTEM_AUDIT_MITRE|}

#######################################################################
# PAM and Authentication
#######################################################################

## PAM configuration
-w /etc/pam.d/ -p wa{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1071_Standard_Application_Layer_Protocol{|/LINUX_SYSTEM_AUDIT_MITRE|}
