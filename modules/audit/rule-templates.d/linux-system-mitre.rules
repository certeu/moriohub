#######################################################################
# Privilege Escalation Detection
#######################################################################

## Root access in user directories
-a always,exit -F dir=/home -F uid=0 -F auid>=1000 -F auid!=unset -C auid!=obj_uid{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1169_Sudo{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Process injection detection
-a always,exit -F arch=b32 -S ptrace{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1055_Process_Injection{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b64 -S ptrace{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1055_Process_Injection{|/LINUX_SYSTEM_AUDIT_MITRE|}

## Specific ptrace operations
-a always,exit -F arch=b32 -S ptrace -F a0=0x4{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1055_Process_Injection{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b64 -S ptrace -F a0=0x4{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1055_Process_Injection{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S ptrace -F a0=0x5{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1055_Process_Injection{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b64 -S ptrace -F a0=0x5{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1055_Process_Injection{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b32 -S ptrace -F a0=0x6{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1055_Process_Injection{|/LINUX_SYSTEM_AUDIT_MITRE|}
-a always,exit -F arch=b64 -S ptrace -F a0=0x6{|#LINUX_SYSTEM_AUDIT_MITRE|} -k T1055_Process_Injection{|/LINUX_SYSTEM_AUDIT_MITRE|}

